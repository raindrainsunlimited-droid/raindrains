{
  "version": 2,
  "builds": [
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "sitemap.xml"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
